---
interface Props {
  title: string;
  description?: string;
  date: Date;
  slug: string;
  tags?: string[];
  categories?: string[];
  readingTime?: number;
}

const { title, description, date, slug, tags = [], categories = [], readingTime } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-entry">
  <header class="entry-header">
    {categories.length > 0 && (
      <p class="entry-eyebrow">
        {categories.map((cat, i) => (
          <>
            <a href={`/categories/${cat.toLowerCase().replace(/ /g, '-')}/`}>{cat}</a>
            {i < categories.length - 1 && <span class="eyebrow-sep"> · </span>}
          </>
        ))}
      </p>
    )}
    <h2>
      <a href={`/posts/${slug}/`}>
        {title}
        <span class="entry-arrow" aria-hidden="true">→</span>
      </a>
    </h2>
  </header>
  {description && (
    <div class="entry-content">
      <p>{description}</p>
    </div>
  )}
  <footer class="entry-footer">
    <time datetime={date.toISOString()}>{formattedDate}</time>
    {readingTime && <span>· {readingTime} min read</span>}
    {tags.length > 0 && (
      <div class="entry-tags">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag.toLowerCase().replace(/ /g, '-')}/`}
            class="tag-chip"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
  </footer>
</article>
