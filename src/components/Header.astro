---
import ThemeToggle from './ThemeToggle.astro';

const { pathname } = Astro.url;
function isCurrent(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="header">
  <nav class="nav" aria-label="Main navigation">
    <div class="logo">
      <a href="/">Unsupervised Leap</a>
    </div>
    <ul class="nav-links">
      <li><a href="/posts/" aria-current={isCurrent('/posts/') ? 'page' : undefined}>Posts</a></li>
      <li><a href="/tags/" aria-current={isCurrent('/tags/') ? 'page' : undefined}>Tags</a></li>
      <li><a href="/now/" aria-current={isCurrent('/now/') ? 'page' : undefined}>Now</a></li>
      <li><a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a></li>
    </ul>
    <ThemeToggle />
  </nav>
</header>
