---
import BaseLayout from '../layouts/BaseLayout.astro';

// Update this date whenever you edit the page
const lastUpdated = new Date('2026-02-22');
const formattedDate = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title="Now"
  description="What Jason Albert is reading, building, thinking about, and working on right now."
>
  <div class="now-page">

    <header class="now-header">
      <div class="now-header-top">
        <h1>Now</h1>
        <p class="now-updated">Updated <time datetime={lastUpdated.toISOString()}>{formattedDate}</time></p>
      </div>
      <p class="now-sub">
        A snapshot of what's actually occupying my attention. Inspired by <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">Derek Sivers</a>.
      </p>
    </header>

    <div class="now-grid">

      <!-- READING -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">📚</span>
          Reading
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">The Alignment Problem</span>
            <span class="now-item-sub">Brian Christian — mid-way through, taking my time</span>
          </li>
          <li>
            <span class="now-item-title">Meditations</span>
            <span class="now-item-sub">Marcus Aurelius — rereading, slowly, in the mornings</span>
          </li>
        </ul>
      </section>

      <!-- BUILDING -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">🔨</span>
          Building
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">This site</span>
            <span class="now-item-sub">Astro + Svelte, deployed on Cloudflare Pages</span>
          </li>
          <li>
            <span class="now-item-title">Writing more consistently</span>
            <span class="now-item-sub">Shorter posts, lower bar, more often</span>
          </li>
        </ul>
      </section>

      <!-- THINKING ABOUT -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">🧠</span>
          Thinking about
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">What corrigibility actually requires</span>
            <span class="now-item-sub">Not just "off switch" — something harder</span>
          </li>
          <li>
            <span class="now-item-title">How to teach a kid to sit with uncertainty</span>
            <span class="now-item-sub">When I can barely do it myself</span>
          </li>
        </ul>
      </section>

      <!-- WATCHING / LISTENING -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">🎧</span>
          Listening
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">80,000 Hours Podcast</span>
            <span class="now-item-sub">Back catalog on AI safety</span>
          </li>
          <li>
            <span class="now-item-title">Lo-fi when writing</span>
            <span class="now-item-sub">Brain needs something to ignore</span>
          </li>
        </ul>
      </section>

      <!-- EATING / COOKING -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">🍳</span>
          Cooking
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">Perfecting tonkotsu broth</span>
            <span class="now-item-sub">12-hour version, still not there yet</span>
          </li>
          <li>
            <span class="now-item-title">Fermentation experiments</span>
            <span class="now-item-sub">Kimchi is working. Sourdough is not.</span>
          </li>
        </ul>
      </section>

      <!-- LOCATION / LIFE -->
      <section class="now-card">
        <h2 class="now-card-title">
          <span class="now-icon" aria-hidden="true">📍</span>
          Life
        </h2>
        <ul class="now-list">
          <li>
            <span class="now-item-title">Dad life, full time</span>
            <span class="now-item-sub">Every day a different distribution shift</span>
          </li>
          <li>
            <span class="now-item-title">Trying to read before the phone</span>
            <span class="now-item-sub">Batting around .300</span>
          </li>
        </ul>
      </section>

    </div>

    <footer class="now-footer">
      <p>This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">/now page</a>. If you have one too, I'd like to read it.</p>
    </footer>

  </div>
</BaseLayout>

<style>
  .now-page {
    display: flex;
    flex-direction: column;
    gap: 2.25em;
  }

  /* ── HEADER ── */
  .now-header {
    background: var(--entry);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.75em 2em;
  }

  .now-header-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1em;
    flex-wrap: wrap;
    margin-bottom: 0.6em;
  }

  .now-header h1 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1.8em, 4vw, 2.4em);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--primary);
  }

  .now-updated {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.78em;
    color: var(--secondary);
    white-space: nowrap;
  }

  .now-sub {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.95em;
    color: var(--secondary);
    line-height: 1.6;
  }

  .now-sub a {
    color: var(--link);
    text-decoration: none;
  }
  .now-sub a:hover { text-decoration: underline; }

  /* ── GRID ── */
  .now-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1em;
  }

  /* ── CARD ── */
  .now-card {
    background: var(--entry);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.4em 1.5em 1.5em;
    transition: border-color 0.2s ease;
  }

  .now-card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
  }

  .now-card-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    margin: 0 0 1em;
    font-family: var(--font-sans);
    font-size: 0.78em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: var(--secondary);
  }

  .now-icon {
    font-size: 1.2em;
  }

  /* ── LIST ── */
  .now-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9em;
  }

  .now-list li {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    padding-left: 0.85em;
    border-left: 2px solid color-mix(in srgb, var(--accent) 35%, var(--border));
  }

  .now-item-title {
    font-family: var(--font-sans);
    font-size: 0.9em;
    font-weight: 600;
    color: var(--primary);
    line-height: 1.3;
  }

  .now-item-sub {
    font-family: var(--font-serif);
    font-size: 0.82em;
    color: var(--secondary);
    font-style: italic;
    line-height: 1.45;
  }

  /* ── FOOTER ── */
  .now-footer {
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.82em;
    color: var(--secondary);
  }

  .now-footer a {
    color: var(--link);
    text-decoration: none;
  }
  .now-footer a:hover { text-decoration: underline; }

  /* ── RESPONSIVE ── */
  @media (max-width: 560px) {
    .now-grid {
      grid-template-columns: 1fr;
    }

    .now-header {
      padding: 1.4em 1.25em;
    }
  }
</style>
