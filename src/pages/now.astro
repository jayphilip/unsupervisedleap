---
import BaseLayout from '../layouts/BaseLayout.astro';

const lastUpdated = new Date('2026-03-09');
const formattedDate = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!-- VARIANT 3: "Magazine" — large hero text, asymmetric two-column grid, feels alive -->

<BaseLayout title="Now" description="What Jason Albert is working on, reading, and thinking about right now.">
  <div class="now-v3">

    <header class="v3-header">
      <p class="v3-kicker">
        Updated: <time datetime={lastUpdated.toISOString()}>{formattedDate}</time>
      </p>
      <h1 class="v3-title">Right now.</h1>
      <p class="v3-sub">
        What's actually occupying my attention — not what I think I should be doing.
        Inspired by <a href="https://nownownow.com/about" target="_blank" rel="noopener">Derek Sivers</a>.
      </p>
    </header>

    <div class="v3-body">

      <!-- Left column: large featured items -->
      <div class="v3-col-main">

        <section class="v3-feature">
          <span class="v3-feature-label">📚 Reading</span>
          <div class="v3-feature-items">
            <article class="v3-feature-item">
              <h3>Open Socrates</h3>
              <p class="v3-byline">Agnes Callard</p>
              <p>A refreshing take on Socrates</p>
            </article>
            <article class="v3-feature-item">
              <h3>Consciousness Explained</h3>
              <p class="v3-byline">Daniel Dennett</p>
              <p>Trying to wrap my head around consciousness</p>
            </article>
          </div>
        </section>

        <section class="v3-feature">
          <span class="v3-feature-label">🧠 Thinking about</span>
          <div class="v3-feature-items">
            <article class="v3-feature-item">
              <h3>What corrigibility actually requires</h3>
              <p>Not just "off switch" — something harder</p>
            </article>
            <article class="v3-feature-item">
              <h3>How to teach a kid to sit with uncertainty</h3>
              <p>When I can barely do it myself</p>
            </article>
          </div>
        </section>

      </div>

      <!-- Right column: compact stacked items -->
      <div class="v3-col-side">

        <section class="v3-compact">
          <span class="v3-compact-label">🔨 Building</span>
          <ul class="v3-compact-list">
            <li>
              <strong>This site</strong>
              <span>Astro + Svelte, deployed on Cloudflare Pages</span>
            </li>
            <li>
              <strong>Writing more consistently</strong>
              <span>Shorter posts, lower bar, more often</span>
            </li>
          </ul>
        </section>

        <section class="v3-compact">
          <span class="v3-compact-label">🎧 Listening</span>
          <ul class="v3-compact-list">
            <li>
              <strong>Feel Good Radio</strong>
              <span>Apple Music</span>
            </li>
            <li>
              <strong>Teenage years playlist</strong>
              <span>Nostalgia is a powerful drug</span>
            </li>
          </ul>
        </section>

        <section class="v3-compact">
          <span class="v3-compact-label">🍳 Cooking</span>
          <ul class="v3-compact-list">
            <li>
              <strong>Toddler-friendly recipes</strong>
              <span>Gourmet for kids?</span>
            </li>
            <li>
              <strong>Cheese exploration</strong>
              <span>Exploring new varieties</span>
            </li>
          </ul>
        </section>

        <section class="v3-compact">
          <span class="v3-compact-label">📍 Life</span>
          <ul class="v3-compact-list">
            <li>
              <strong>Dad life, full time</strong>
              <span>Every day a different distribution shift</span>
            </li>
            <li>
              <strong>Reading before the phone</strong>
              <span>Batting around .300</span>
            </li>
          </ul>
        </section>

      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .now-v3 {
    display: flex;
    flex-direction: column;
    gap: 3em;
  }

  /* Header */
  .v3-header {
    max-width: 620px;
  }

  .v3-kicker {
    font-family: var(--font-mono);
    font-size: 0.8em;
    color: var(--secondary);
    margin: 0 0 0.9em;
    letter-spacing: 0.04em;
  }

.v3-title {
    font-family: var(--font-sans);
    font-size: clamp(3em, 7vw, 5em);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1.0;
    color: var(--primary);
    margin: 0 0 0.5em;
  }

  .v3-sub {
    font-family: var(--font-serif);
    font-size: 1.05em;
    color: var(--secondary);
    line-height: 1.7;
    margin: 0;
  }

  .v3-sub a { color: var(--link); text-decoration: none; }
  .v3-sub a:hover { text-decoration: underline; }

  /* Body: two-column asymmetric */
  .v3-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2.5em;
    align-items: start;
  }

  /* Left: feature sections */
  .v3-col-main {
    display: flex;
    flex-direction: column;
    gap: 2.5em;
  }

  .v3-feature {
    display: flex;
    flex-direction: column;
    gap: 1.25em;
    padding-bottom: 2.5em;
    border-bottom: 1px solid var(--border);
  }

  .v3-feature:last-child { border-bottom: none; padding-bottom: 0; }

  .v3-feature-label {
    font-family: var(--font-sans);
    font-size: 0.72em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .v3-feature-items {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }

  .v3-feature-item h3 {
    font-family: var(--font-sans);
    font-size: 1.15em;
    font-weight: 700;
    color: var(--primary);
    margin: 0 0 0.25em;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .v3-byline {
    font-family: var(--font-sans);
    font-size: 0.82em;
    color: var(--accent);
    margin: 0 0 0.3em;
    font-weight: 500;
  }

  .v3-feature-item p {
    font-family: var(--font-serif);
    font-size: 0.9em;
    color: var(--secondary);
    margin: 0;
    line-height: 1.6;
    font-style: italic;
  }

  /* Right: compact list sections */
  .v3-col-side {
    display: flex;
    flex-direction: column;
    gap: 1.75em;
    padding-left: 2em;
    border-left: 1px solid var(--border);
  }

  .v3-compact-label {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72em;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--secondary);
    margin-bottom: 0.75em;
  }

  .v3-compact-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75em;
  }

  .v3-compact-list li {
    display: flex;
    flex-direction: column;
    gap: 0.1em;
  }

  .v3-compact-list strong {
    font-family: var(--font-sans);
    font-size: 0.88em;
    font-weight: 600;
    color: var(--primary);
  }

  .v3-compact-list span {
    font-family: var(--font-serif);
    font-size: 0.8em;
    color: var(--secondary);
    font-style: italic;
    line-height: 1.4;
  }

  @media (max-width: 700px) {
    .v3-body {
      grid-template-columns: 1fr;
    }

    .v3-col-side {
      padding-left: 0;
      border-left: none;
      border-top: 1px solid var(--border);
      padding-top: 2em;
    }

    .v3-title {
      font-size: clamp(2.5em, 10vw, 3em);
    }
  }
</style>
