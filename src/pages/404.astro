---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page Not Found">
  <div style="text-align: center; padding: 6em 0;">
    <p style="font-size: 5em; margin: 0;">🧠</p>
    <h1 style="font-size: 2.5em; font-weight: 800; margin: 0.5em 0 0.25em;">404</h1>
    <p style="color: var(--secondary); font-size: 1.2em; margin: 0 0 2em;">
      This page wasn't found. Maybe it was never labelled to begin with.
    </p>
    <a href="/" style="color: var(--link); font-weight: 600;">← Back to home</a>
  </div>
</BaseLayout>
